[Unit]
Description=Exposure benchmark trusted controller
After=network-online.target benchmark-executor.service
Wants=network-online.target benchmark-executor.service

[Service]
Type=simple
User=exposure-controller
Group=exposure-controller
SupplementaryGroups=exposure-benchmark
EnvironmentFile=/etc/exposure-benchmark/controller.env
ExecStart=/opt/exposure-benchmark/bin/benchmark-controller
Restart=always
RestartSec=2s
UMask=0007

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/run/exposure-benchmark/gateways

[Install]
WantedBy=multi-user.target

/target
.env

# lesson video source URLs — committed hex-encoded in videos.dat instead
video_links.md

# applicant exports — PII (names, emails, phones, essays), never commit
academy-applicants-*.csv

# harness runner benchmark caches — recreated on the EC2 host, never copied from a venv
services/benchmark-node/adapters/cache/
# Pre-monorepo local cache. Keep it out of Git; EC2 recreates pinned caches from scratch.
/worker/cache/

# benchmark-node runtime state belongs under /var/lib in production
services/benchmark-node/state/

# python bytecode from the harness runner
__pycache__/
*.pyc

# macOS Finder droppings — one got committed with a folder of PDFs once already
.DS_Store

# monopoly artifact cache + validation scratch — 100M+ of runtime state
/var/
# downloaded agent artifacts — GB-scale, recreated by cache_artifact() on demand
/services/monopoly-worker/.artifact-cache/

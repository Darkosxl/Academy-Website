# Supabase: Settings -> Database -> Connection string (URI). Use the "session" pooler string if direct fails.
DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
ADMIN_EMAIL=bscemarslan@gmail.com
RESEND_API_KEY=re_your_key
MAIL_FROM=Exposure Academy <noreply@yourdomain.com>
APP_BASE_URL=https://your-deployed-domain.com
INVITE_CODE=give-this-code-to-students
WORKER_TOKEN=generate-a-long-random-string
# AWS Bedrock application inference profile used by every harness submission.
# BEDROCK_API_KEY is normalized to AWS_BEARER_TOKEN_BEDROCK inside the trusted gateway.
BEDROCK_API_KEY=
AWS_REGION=us-east-1
# Bedrock Mantle Responses API model in us-east-1.
BEDROCK_MODEL_ID=xai.grok-4.3
BEDROCK_PROFILE_NAME=grok-4.3
BEDROCK_LATENCY=standard
BEDROCK_REASONING_EFFORT=none
BEDROCK_MAX_CONCURRENCY=32
# Use production in deployment and run the worker as this dedicated unprivileged account.
HARNESS_ENV=local
HARNESS_HARBOR_USER=harness-worker
# 32 random bytes as 64 hexadecimal characters. Blank disables official Kaggle submission.
KAGGLE_CREDENTIAL_KEY=
BIND=0.0.0.0:3000
# Optional. Microlink API key for example-project screenshots (blank = free tier, fine at low volume).
MICROLINK_API_KEY=

# Supabase: Settings -> Database -> Connection string (URI). Use the "session" pooler string if direct fails.
DATABASE_URL=postgres://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
ADMIN_EMAIL=bscemarslan@gmail.com
RESEND_API_KEY=re_your_key
MAIL_FROM=Exposure Academy <noreply@yourdomain.com>
APP_BASE_URL=https://your-deployed-domain.com
INVITE_CODE=give-this-code-to-students
WORKER_TOKEN=generate-a-long-random-string
# Academy's persistent artifact disk; a co-located controller may share it as a fast path.
MONOPOLY_ARTIFACT_DIR=var/monopoly-artifacts
# Public Academy origin used by the host controller and Colab workers.
MONOPOLY_SITE=https://your-deployed-domain.com
# AWS Bedrock application inference profile used by every harness submission.
# BEDROCK_API_KEY is normalized to AWS_BEARER_TOKEN_BEDROCK inside the trusted
# gateway for harness runs.
BEDROCK_API_KEY=
# Four distinct keys, comma-separated for local development. Production reads the
# same four values as a JSON array from BENCHMARK_SECRET_ID in Secrets Manager.
CEREBRAS_API_KEYS=
# One key only — DeepInfra rate limits per account, so more keys add nothing.
# Serves Qwen/Qwen3.6-27B for the harness, AND read directly by the academy
# server for the Chatbot Challenge (Beginner Track) — DeepSeek-V3.2, a fixed
# const in chatbot_challenge.rs, not this var. Production reads the same value
# from BENCHMARK_SECRET_ID.
DEEPINFRA_API_KEY=
AWS_REGION=us-east-1
# Bedrock Mantle Responses API model in us-east-1. Used only as services/benchmark-node's
# default harness model.
BEDROCK_MODEL_ID=xai.grok-4.3
BEDROCK_PROFILE_NAME=grok-4.3
BEDROCK_LATENCY=standard
BEDROCK_REASONING_EFFORT=none
BEDROCK_MAX_CONCURRENCY=32
# DEV enables local Academy HTTP and repository-local benchmark assets. Production hosts
# explicitly set PROD; HARNESS_ENV=local/production remains accepted during rollout.
ENVIRONMENT=DEV
HARNESS_HARBOR_USER=harness-worker
# 32 random bytes as 64 hexadecimal characters. Blank disables official Kaggle submission.
KAGGLE_CREDENTIAL_KEY=
BIND=0.0.0.0:3000
# Optional. Microlink API key for example-project screenshots (blank = free tier, fine at low volume).
MICROLINK_API_KEY=
